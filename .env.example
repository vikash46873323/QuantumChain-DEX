# QuantumChain DEX Configuration

# Blockchain Network
NETWORK=ethereum
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
CHAIN_ID=1
GAS_PRICE=50

# MetaMask
METAMASK_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
QUANTUM_TOKEN_ADDRESS=0x1111111111111111111111111111111111111111

# DEX Configuration
DEX_FEE_PERCENTAGE=0.3
SLIPPAGE_TOLERANCE=0.5
MIN_LIQUIDITY=1000

# Gaming Configuration
GAME_REWARD_MULTIPLIER=1.0
GAME_DAILY_LIMIT=10
LEARBOARD_LIMIT=100

# NFT Configuration
NFT_ROYALTY_PERCENTAGE=10
NFT_MIN_PRICE=1
NFT_MAX_SUPPLY=10000

# Payment Integration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# API Keys
INFURA_API_KEY=your_infura_api_key
ALCHEMY_API_KEY=your_alchemy_api_key

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quantumchain_dex
DB_USER=postgres
DB_PASSWORD=your_password

# Server Configuration
PORT=3000
NODE_ENV=development
DEBUG=true

# Security
JWT_SECRET=your_jwt_secret_key
SESSION_SECRET=your_session_secret

# Features
ENABLE_FLASH_LOANS=true
ENABLE_GOVERNANCE=false
ENABLE_STAKING=true
